{
  "name": "apm-crash-monitor-serverless",
  "version": "1.0.0",
  "description": "Serverless APM and crash monitor backend for Cloudflare Workers, fully compatible with Sentry SDK",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "d1:init-local": "wrangler d1 execute flarepulse-db --local --file=./schema/schema.sql",
    "d1:init-remote": "wrangler d1 execute flarepulse-db --remote --file=./schema/schema.sql"
  },
  "keywords": [
    "apm",
    "sentry",
    "crash-monitor",
    "cloudflare-workers",
    "cloudflare-d1",
    "serverless",
    "php",
    "hono"
  ],
  "author": "mcontartesi",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.7.2",
    "jose": "^6.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.123.0"
  }
}
