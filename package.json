{
  "name": "flarepulse-apm",
  "version": "1.0.0",
  "description": "A 100% Cloudflare Serverless, Sentry-compatible APM and Crash Monitor",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "d1:init-local": "wrangler d1 execute flarepulse-db --local --file=./schema/schema.sql",
    "d1:init-remote": "wrangler d1 execute flarepulse-db --remote --file=./schema/schema.sql"
  },
  "keywords": [
    "apm",
    "sentry",
    "crash-monitor",
    "cloudflare-workers",
    "cloudflare-d1",
    "serverless",
    "php",
    "hono"
  ],
  "author": "FlarePulse Team",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.7.2",
    "jose": "^6.0.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6",
    "wrangler": "^3.111.0"
  }
}
